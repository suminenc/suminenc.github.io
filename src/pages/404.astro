---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="페이지를 찾을 수 없습니다">
  <div class="page-head">
    <div class="inner">
      <h1>페이지를 찾을 수 없습니다</h1>
      <p class="lead">주소가 바뀌었거나 없는 페이지입니다.</p>
    </div>
  </div>
  <div class="inner">
    <section class="section">
      <div class="btns">
        <a class="btn" href="/">첫 화면으로</a>
        <a class="btn line" href="/contact/">문의</a>
      </div>
    </section>
  </div>
</BaseLayout>
