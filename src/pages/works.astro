---
import BaseLayout from '../layouts/BaseLayout.astro';
import { works } from '../data/works';
import { company } from '../data/site';
import CountUp from '../components/CountUp.astro';

const label = { reinforce: '구조보강', pile: '소구경파일' } as const;
const first = works.reduce((y, w) => Math.min(y, Number(w.ym.slice(0, 4))), 9999);
const total = works.length;
const nRein = works.filter((w) => w.method === 'reinforce').length;
const nPile = works.filter((w) => w.method === 'pile').length;
const nPublic = works.filter((w) => w.pub).length;
const who = (w: (typeof works)[number]) => [w.owner, w.builder].filter(Boolean).join(' / ');
const years = [...new Set(works.map((w) => w.ym.slice(0, 4)))].sort((a, b) => b.localeCompare(a));
const byYear = years.map((y) => ({ y, items: works.filter((w) => w.ym.startsWith(y)) }));
// 연도별 막대 그래프(옛 해 → 최근 해). 막대를 누르면 아래 목록이 그 해로 바뀐다(2026-11-14 연도 연동)
const bars = [...years].reverse().map((y) => {
  const it = works.filter((w) => w.ym.startsWith(y));
  return { y, r: it.filter((w) => w.method === 'reinforce').length, p: it.filter((w) => w.method === 'pile').length, n: it.length };
});
const barMax = Math.max(...bars.map((b) => b.n));
---
<BaseLayout
  title="시공 경력"
  description={`${company.name} 시공 경력 — ${first}년부터 한길특수건설(주) 시절을 포함해 구조보강·소구경파일 현장 ${total}곳 참여. 학교·관공서·공장·상가 등 연도별 공사 목록.`}
  section="works"
>
  <div class="page-head">
    <div class="inner">
      <p class="crumb">시공 경력</p>
      <h1>시공 경력</h1>
      <p class="lead">{first}년부터 한길특수건설(주) 시절을 포함해 구조보강·소구경파일 현장 {total}곳에 참여했습니다.</p>
    </div>
  </div>

  <div class="inner">
    <section class="section">
      <div class="stats">
        <div><b data-count>{total}</b><span>참여 현장</span></div>
        <div><b data-count>{nRein}</b><span>구조보강</span></div>
        <div><b data-count>{nPile}</b><span>소구경파일</span></div>
        <div><b data-count>{nPublic}</b><span>공공기관</span></div>
      </div>
    </section>

    <section class="section chart" aria-labelledby="chart-h">
      <div class="chart-head">
        <h2 id="chart-h">연도별 참여 현장</h2>
        <p class="legend"><span class="k reinforce"></span>구조보강 <span class="k pile"></span>소구경파일</p>
      </div>
      <p class="chart-tip">막대를 누르면 그해 공사 목록을 봅니다.</p>
      <div class="bars" style={`--max:${barMax}`}>
        {bars.map((b) => (
          <button type="button" class="bar" data-y={b.y} aria-label={`${b.y}년 ${b.n}곳 (구조보강 ${b.r}, 소구경파일 ${b.p})`} aria-pressed="false">
            <span class="n">{b.n}</span>
            <span class="col" style={`--h:${b.n}`}>
              <span class="seg pile" style={`--v:${b.p}`}></span>
              <span class="seg reinforce" style={`--v:${b.r}`}></span>
            </span>
            <span class="yy"><span class="full">{b.y}</span><span class="short">'{b.y.slice(2)}</span></span>
          </button>
        ))}
      </div>
    </section>

    <section class="section works">
      <div class="filters">
        <div class="tabs" role="tablist" aria-label="공법">
          <button type="button" role="tab" data-m="" aria-selected="true">전체</button>
          <button type="button" role="tab" data-m="reinforce" aria-selected="false">구조보강</button>
          <button type="button" role="tab" data-m="pile" aria-selected="false">소구경파일</button>
        </div>
        <div class="pick">
          <label class="sr-only" for="w-year">연도</label>
          <select id="w-year">
            <option value="">모든 연도</option>
            {years.map((y) => <option value={y}>{y}년</option>)}
          </select>
          <label class="sr-only" for="w-q">공사명 검색</label>
          <input id="w-q" type="search" placeholder="공사명·회사 이름 검색 (예: 학교, SK, 현대)" autocomplete="off">
        </div>
        <p class="count" aria-live="polite"><b id="w-n">{total}</b>곳</p>
      </div>

      {byYear.map(({ y, items }) => (
        <div class="year" data-year={y}>
          <h2>{y}<small><span class="yn">{items.length}</span>곳</small></h2>
          <ul class="list">
            {items.map((w) => (
              <li data-m={w.method} data-q={`${w.title} ${who(w)}`.toLowerCase()}>
                <span class="ym">{w.ym.slice(5)}월</span>
                <span class="tt">{w.title}</span>
                <span class="od">{who(w)}</span>
                <span class={`mt ${w.method}`}>{label[w.method]}</span>
                <span class="bl">{w.blog ? <a href={w.blog} target="_blank" rel="noopener">사례 보기</a> : null}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="empty" hidden>찾는 공사가 없습니다. 검색어를 바꿔 보세요.</p>
      <p class="note">회사 이름은 발주자 / 원청사 순서입니다. 공사 금액은 싣지 않습니다.</p>
    </section>

    <section class="section">
      <div class="cta">
        <p>비슷한 현장의 보강·기초 공사를 검토 중이신가요?</p>
        <a class="btn" href="/contact/">문의하기</a>
      </div>
    </section>
  </div>
  <CountUp />
</BaseLayout>

<style>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gap); }
  .stats div { background: var(--soft); border-radius: var(--radius); padding: 22px 20px; display: flex; flex-direction: column; gap: 4px; }
  .stats b { font-size: 34px; color: var(--navy); line-height: 1.1; letter-spacing: -.02em; }
  .stats span { color: var(--muted); font-size: 15px; }

  /* 연도별 막대 그래프 */
  .chart { margin-top: 40px; }
  .chart-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .chart-head h2 { font-size: 22px; color: var(--navy); }
  .legend { color: var(--muted); font-size: 14px; display: flex; align-items: center; gap: 6px; }
  .legend .k { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-left: 8px; }
  .k.reinforce, .seg.reinforce { background: var(--steel); }
  .k.pile, .seg.pile { background: #8C9A3E; }
  .chart-tip { color: var(--muted); font-size: 14px; margin-top: 2px; }
  .bars { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 6px; align-items: end; height: 220px; margin-top: 14px; padding-bottom: 2px; border-bottom: 1.5px solid var(--line); }
  .bar { all: unset; box-sizing: border-box; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: stretch; cursor: pointer; border-radius: 6px 6px 0 0; }
  .bar:focus-visible { outline: 2px solid var(--steel); outline-offset: 2px; }
  .bar .n { text-align: center; font-size: 13px; font-weight: 700; color: var(--navy); font-variant-numeric: tabular-nums; }
  .bar .col { display: flex; flex-direction: column; height: calc(var(--h) / var(--max) * (100% - 44px)); min-height: 3px; border-radius: 5px 5px 0 0; overflow: hidden; transform-origin: bottom; transition: transform .8s cubic-bezier(.2,.7,.2,1), opacity .2s; }
  .bar .seg { display: block; flex: var(--v) 0 0; }
  .bar .yy { text-align: center; font-size: 12.5px; color: var(--muted); margin-top: 6px; font-variant-numeric: tabular-nums; }
  .bar .short { display: none; }
  .bar:hover .col { opacity: .82; }
  .bars.has-pick .bar[aria-pressed='false'] .col { opacity: .3; }
  .bar[aria-pressed='true'] .yy { color: var(--navy); font-weight: 700; }
  .bars.grow .col { transform: scaleY(0); }
  @media (prefers-reduced-motion: reduce) { .bar .col { transition: none; } .bars.grow .col { transform: none; } }

  .works { margin-top: 40px; }
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding-bottom: 18px; border-bottom: 2px solid var(--navy); position: sticky; top: 76px; background: #fff; z-index: 5; padding-top: 12px; }
  .tabs { display: flex; gap: 6px; }
  .tabs button { border: 1.5px solid var(--line); background: #fff; color: var(--ink); border-radius: 999px; padding: 8px 16px; font: inherit; font-size: 15px; cursor: pointer; }
  .tabs button[aria-selected='true'] { background: var(--navy); border-color: var(--navy); color: #fff; font-weight: 700; }
  .pick { display: flex; gap: 8px; flex: 1; min-width: 260px; }
  .pick select, .pick input { font: inherit; font-size: 15px; border: 1.5px solid var(--line); border-radius: 10px; padding: 8px 12px; background: #fff; color: var(--ink); }
  .pick input { flex: 1; min-width: 0; }
  .count { margin-left: auto; color: var(--muted); font-size: 15px; white-space: nowrap; flex-shrink: 0; }
  .year[hidden], .list li[hidden] { display: none; }
  .count b { color: var(--navy); font-size: 18px; margin-right: 2px; }

  .year { margin-top: 36px; scroll-margin-top: 190px; }
  .year h2 { font-size: 22px; color: var(--navy); margin-bottom: 8px; }
  .year h2 small { font-size: 15px; color: var(--muted); font-weight: 400; margin-left: 8px; }
  .list li { display: grid; grid-template-columns: 52px 1fr 250px 92px 76px; gap: 14px; align-items: center; padding: 12px 4px; border-bottom: 1px solid var(--line); font-size: 15.5px; }
  .list .ym { color: var(--muted); font-variant-numeric: tabular-nums; }
  .list .tt { color: var(--ink); }
  .list .od { color: var(--muted); font-size: 14.5px; }
  .list .mt { justify-self: start; font-size: 13px; font-weight: 500; border-radius: 6px; padding: 2px 9px; }
  .list .mt.reinforce { background: #E7EEF6; color: var(--steel); }
  .list .mt.pile { background: #EEF0E4; color: #5B6326; }
  .list .bl a { font-size: 14px; color: var(--steel); }
  .empty { margin-top: 32px; color: var(--muted); }
  .note { margin-top: 28px; color: var(--muted); font-size: 14px; }

  .cta { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; background: var(--soft); border-radius: var(--radius); padding: 24px 28px; }
  .cta p { font-size: 17px; font-weight: 500; color: var(--navy); }

  @media (max-width: 860px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .list li { grid-template-columns: 44px 1fr auto; grid-template-areas: 'ym tt tt' '. od mt' '. bl bl'; gap: 4px 10px; }
    .list .ym { grid-area: ym; }
    .list .tt { grid-area: tt; }
    .list .od { grid-area: od; }
    .list .mt { grid-area: mt; }
    .list .bl { grid-area: bl; }
    .list .bl:empty { display: none; }
  }
  @media (max-width: 860px) {
    .bars { gap: 3px; height: 180px; }
    .bar .full { display: none; }
    .bar .short { display: inline; }
    .bar .n { font-size: 11.5px; }
    .bar .yy { font-size: 11px; }
  }
  @media (max-width: 520px) {
    .filters { top: 64px; }
    .year { scroll-margin-top: 250px; }
    .stats b { font-size: 28px; }
    .stats div { padding: 16px; }
    .tabs button { padding: 7px 12px; font-size: 14.5px; }
    .pick { min-width: 100%; }
    .count { margin-left: 0; }
    .list li { font-size: 15px; }
    .cta { padding: 20px; }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs button')];
  const yearSel = document.getElementById('w-year') as HTMLSelectElement;
  const q = document.getElementById('w-q') as HTMLInputElement;
  const n = document.getElementById('w-n')!;
  const empty = document.querySelector<HTMLElement>('.empty')!;
  const groups = [...document.querySelectorAll<HTMLElement>('.year')];
  let m = new URLSearchParams(location.search).get('m') ?? '';
  if (!['reinforce', 'pile'].includes(m)) m = '';

  function apply() {
    const y = yearSel.value;
    const words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let total = 0;
    for (const g of groups) {
      let k = 0;
      const yearOk = !y || g.dataset.year === y;
      for (const li of g.querySelectorAll<HTMLElement>('li')) {
        const ok = yearOk && (!m || li.dataset.m === m) && words.every((w) => li.dataset.q!.includes(w));
        li.hidden = !ok;
        if (ok) k++;
      }
      g.hidden = k === 0;
      g.querySelector('.yn')!.textContent = String(k);
      total += k;
    }
    n.textContent = String(total);
    empty.hidden = total > 0;
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.m === m)));
  }

  tabs.forEach((t) => t.addEventListener('click', () => {
    m = t.dataset.m ?? '';
    const u = new URL(location.href);
    if (m) u.searchParams.set('m', m); else u.searchParams.delete('m');
    history.replaceState(null, '', u);
    apply();
  }));
  // 연도별 막대 — 누르면 연도 선택칸과 같이 바뀐다. 같은 막대를 다시 누르면 「모든 연도」
  const barBox = document.querySelector<HTMLElement>('.bars')!;
  const bars = [...barBox.querySelectorAll<HTMLButtonElement>('.bar')];
  function markBars() {
    const y = yearSel.value;
    bars.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.y === y)));
    barBox.classList.toggle('has-pick', !!y);
  }
  bars.forEach((b) => b.addEventListener('click', () => {
    yearSel.value = yearSel.value === b.dataset.y ? '' : b.dataset.y!;
    apply();
    markBars();
    if (yearSel.value) document.querySelector(`.year[data-year="${yearSel.value}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  // 화면에 들어오면 막대가 아래에서 차오름
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    barBox.classList.add('grow');
    const io = new IntersectionObserver((l) => { if (l[0].isIntersecting) { barBox.classList.remove('grow'); io.disconnect(); } }, { threshold: 0.3 });
    io.observe(barBox);
    // 안전장치: 3초 뒤에도 화면에 보이는데 막대가 안 올라왔으면 그냥 보여 줌
    setTimeout(() => {
      const r = barBox.getBoundingClientRect();
      if (barBox.classList.contains('grow') && r.top < innerHeight && r.bottom > 0) { barBox.classList.remove('grow'); io.disconnect(); }
    }, 3000);
  }

  yearSel.addEventListener('change', () => { apply(); markBars(); });
  q.addEventListener('input', apply);
  apply();
  markBars();
</script>
