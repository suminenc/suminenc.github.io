---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/site';
import { byGroup, groups } from '../data/methods';
---
<BaseLayout title="회사 소개" section="about">
  <div class="page-head">
    <div class="inner">
      <p class="crumb">회사 소개</p>
      <h1>{company.name}</h1>
      <p class="lead">{company.nameEn}</p>
    </div>
  </div>
  <div class="inner">
    <section class="section">
      <h2>인사말</h2>
      <div class="text greeting">
        <p>{company.name}는 건축물 구조보강과 소구경파일 기초보강 공사를 하는 회사입니다.</p>
        <p>오래된 건물, 하중이 늘어난 건물, 좁아서 큰 장비가 들어가지 못하는 현장일수록 정확한 공법 선택이 중요합니다. 현장 여건을 먼저 살피고, 알맞은 공법을 제안해 꼼꼼하게 시공하겠습니다.</p>
        <p>대표가 보유한 특허 공법 3건(SMART섬유보강, 마이크로파일 상부정착 HNC, 마찰저항증대 FIP)으로 더 경제적이고 튼튼한 보강을 약속드립니다.</p>
        <p class="sign">{company.name} 대표 <b>{company.ceo}</b></p>
      </div>
    </section>

    <section class="section">
      <h2>하는 일</h2>
      <div class="work">
        {(['reinforce', 'pile'] as const).map((g) => (
          <a class="work-box" href={`/method/${g}/`}>
            <h3>{groups[g].title}</h3>
            <ul class="dots">{byGroup(g).map((m) => <li>{m.title}</li>)}</ul>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>사업장 정보</h2>
      <div class="info">
        <div class="row"><b>상호</b><span>{company.name} ({company.nameEn})</span></div>
        <div class="row"><b>대표</b><span>{company.ceo}</span></div>
        <div class="row"><b>주소</b><span>{company.address}</span></div>
        <div class="row"><b>휴대폰</b><a href={`tel:${company.phone}`}>{company.phone}</a></div>
        <div class="row"><b>이메일</b><a href={`mailto:${company.email}`}>{company.email}</a></div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .greeting { max-width: 760px; font-size: 16.5px; }
  .greeting .sign { margin-top: 18px; color: var(--muted); }
  .greeting .sign b { color: var(--navy); margin-left: 6px; font-size: 18px; }
  .work { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .work-box { display: block; background: var(--soft); border-radius: 12px; padding: 20px 22px; text-decoration: none; color: var(--ink); }
  .work-box h3 { color: var(--steel); font-size: 17px; margin-bottom: 8px; }
  @media (max-width: 520px) { .work { grid-template-columns: 1fr; } }
</style>
