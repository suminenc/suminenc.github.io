---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MethodCards from '../../../components/MethodCards.astro';
import { byGroup, groups, type Method } from '../../../data/methods';

export function getStaticPaths() {
  return (Object.keys(groups) as Method['group'][]).map((group) => ({ params: { group } }));
}

const group = Astro.params.group as Method['group'];
const g = groups[group];
---
<BaseLayout title={g.title} description={g.lead} section={group}>
  <div class="page-head">
    <div class="inner">
      <p class="crumb">공법 소개</p>
      <h1>{g.title}</h1>
      <p class="lead">{g.lead}</p>
    </div>
  </div>
  <div class="inner">
    <section class="section">
      <MethodCards items={byGroup(group)} />
    </section>
    <section class="section">
      <a class="works-link" href={`/works/?m=${group}`}>{g.title} 시공 경력 보기 →</a>
    </section>
  </div>
</BaseLayout>

<style>
  .works-link { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border: 1.5px solid var(--navy); border-radius: 10px; color: var(--navy); font-weight: 700; text-decoration: none; }
  .works-link:hover { background: var(--navy); color: #fff; }
</style>
