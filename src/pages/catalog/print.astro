---
// 카탈로그 인쇄용 페이지(A4 세로 16쪽). Edge로 PDF를 뽑는다: tools/web-images/make_catalog_pdf.ps1
import { company } from '../../data/site';
import { groups, methods, patents, type Block, type Method } from '../../data/methods';
import { catalogPages, overview, type CatBlock } from '../../data/catalog';

const bySlug = (s: string) => methods.find((m) => m.slug === s)!;

type CB = Block & { cols?: number; ratio?: string };
type Sheet =
  | { kind: 'cover' } | { kind: 'toc' } | { kind: 'about' } | { kind: 'patent' } | { kind: 'overview' } | { kind: 'back' }
  | { kind: 'method'; m: Method; part?: string; blocks: CB[] };

// 카탈로그용으로 블록을 고른다(칸 수·항목 고르기)
const pick = (m: Method, c: CatBlock): CB => {
  const b = m.blocks[c.block];
  if (!b) throw new Error(`${m.slug} block ${c.block} 없음`);
  const out: any = { ...b, cols: c.cols, ratio: c.ratio };
  if (c.title) out.title = c.title;
  if (c.take && 'items' in b) out.items = c.take.map((i) => (b.items as any[])[i]);
  return out;
};

const sheets: Sheet[] = [
  { kind: 'cover' }, { kind: 'toc' }, { kind: 'about' }, { kind: 'patent' }, { kind: 'overview' },
  ...catalogPages.map((p) => {
    const m = bySlug(p.slug);
    return { kind: 'method' as const, m, part: p.part, blocks: p.blocks.map((c) => pick(m, c)) };
  }),
  { kind: 'back' },
];

// 목차: 공법마다 첫 쪽 번호
const toc: { m: Method; page: number }[] = [];
sheets.forEach((s, i) => {
  if (s.kind === 'method' && !toc.some((t) => t.m.slug === s.m.slug)) toc.push({ m: s.m, page: i + 1 });
});
const groupKeys = ['reinforce', 'pile'] as const;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="robots" content="noindex">
  <title>{company.name} 카탈로그</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
{sheets.map((s, i) => (
  <section class:list={['sheet', s.kind, s.kind === 'method' && s.m.group]}>
    {s.kind === 'cover' && (
      <div class="cover-in">
        <div class="cover-top">
          <img class="cover-symbol" src="/assets/symbol.png" alt="">
          <p class="cover-ko">{company.name}</p>
          <p class="cover-en">{company.nameEn}</p>
        </div>
        <div class="cover-mid">
          <p class="cover-eyebrow">구조보강 · 소구경파일</p>
          <h1>건물을 허물지 않고<br>더 튼튼하게 보강합니다.</h1>
        </div>
        <div class="cover-band">
          <p class="band-tit">대표 보유 특허</p>
          <ul>{patents.map((m) => <li><span>특허 {m.patent!.no}</span>{m.title}</li>)}</ul>
        </div>
      </div>
    )}

    {s.kind === 'toc' && (
      <div class="pad">
        <p class="eyebrow">CONTENTS</p>
        <h2 class="big">차례</h2>
        <ol class="toc-list">
          <li><b>03</b>회사 소개</li>
          <li><b>04</b>대표 보유 특허</li>
          <li><b>05</b>공법 한눈에 보기</li>
        </ol>
        {groupKeys.map((g) => (
          <div class:list={['toc-group', g]}>
            <p class="toc-g">{groups[g].title}</p>
            <ol class="toc-list">
              {toc.filter((t) => t.m.group === g).map((t) => (
                <li><b>{String(t.page).padStart(2, '0')}</b>{t.m.title}{t.m.patent && <em>특허</em>}</li>
              ))}
            </ol>
          </div>
        ))}
        <p class="toc-note">{company.name}는 건축물 구조보강과 소구경파일 기초보강 공사를 합니다.<br>공법마다 실린 QR을 찍으면 홈페이지에서 영상과 자세한 내용을 볼 수 있습니다.</p>
      </div>
    )}

    {s.kind === 'about' && (
      <div class="pad">
        <p class="eyebrow">ABOUT</p>
        <h2 class="big">회사 소개</h2>
        <div class="greet">
          <p>{company.name}는 건축물 구조보강과 소구경파일 기초보강 공사를 하는 회사입니다.</p>
          <p>오래된 건물, 하중이 늘어난 건물, 좁아서 큰 장비가 들어가지 못하는 현장일수록 정확한 공법 선택이 중요합니다. 현장 여건을 먼저 살피고, 알맞은 공법을 제안해 꼼꼼하게 시공하겠습니다.</p>
          <p>대표가 보유한 특허 공법 3건(SMART섬유보강, 마이크로파일 상부정착 HNC, 마찰저항증대 FIP)으로 더 경제적이고 튼튼한 보강을 약속드립니다.</p>
          <p class="sign">{company.name} 대표 <b>{company.ceo}</b></p>
        </div>
        <h3 class="sub">하는 일</h3>
        <div class="work">
          {groupKeys.map((g) => (
            <div class:list={['work-box', g]}>
              <p class="wb-t">{groups[g].title}</p>
              <p class="wb-l">{groups[g].lead}</p>
              <ul class="dots">{methods.filter((m) => m.group === g).map((m) => <li>{m.title}</li>)}</ul>
            </div>
          ))}
        </div>
        <h3 class="sub">사업장 정보</h3>
        <table class="info">
          <tr><th>상호</th><td>{company.name} ({company.nameEn})</td></tr>
          <tr><th>대표</th><td>{company.ceo}</td></tr>
          <tr><th>주소</th><td>{company.address}</td></tr>
          <tr><th>휴대폰</th><td>{company.phone}</td></tr>
          <tr><th>이메일</th><td>{company.email}</td></tr>
        </table>
      </div>
    )}

    {s.kind === 'patent' && (
      <div class="pad">
        <p class="eyebrow">PATENT</p>
        <h2 class="big">대표 보유 특허 3건</h2>
        <p class="lead">특허권자 {company.ceo} · 특허청 등록</p>
        <div class="certs">
          {patents.map((m) => (
            <figure>
              <img src={m.patent!.cert} alt={`특허증 ${m.patent!.no}`}>
              <figcaption>
                <b>특허 {m.patent!.no}</b>
                <span class="pm">{m.title}</span>
                <span class="pn">{m.patent!.name}</span>
                <span class="ps">{m.short}</span>
                <span class="pd">등록일 {m.patent!.registered} · 특허권자 {company.ceo}</span>
                <span class="pg">자세한 내용 {String(toc.find((t) => t.m.slug === m.slug)!.page).padStart(2, '0')}쪽</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    )}

    {s.kind === 'overview' && (
      <div class="pad">
        <p class="eyebrow">OVERVIEW</p>
        <h2 class="big">공법 한눈에 보기</h2>
        <p class="lead">현장 여건에 맞는 공법을 골라 제안합니다.</p>
        {groupKeys.map((g) => (
          <div class:list={['ov', g]}>
            <p class="ov-g">{groups[g].title}</p>
            <table>
              <tr><th>공법</th><th>이런 현장에</th><th>특징</th><th>쪽</th></tr>
              {toc.filter((t) => t.m.group === g).map((t) => (
                <tr>
                  <td class="ov-n">{t.m.title}{t.m.patent && <em>특허</em>}</td>
                  <td>{overview[t.m.slug].fit}</td>
                  <td>{overview[t.m.slug].point}</td>
                  <td class="ov-p">{String(t.page).padStart(2, '0')}</td>
                </tr>
              ))}
            </table>
          </div>
        ))}
      </div>
    )}

    {s.kind === 'method' && (
      <>
        <header class="m-head">
          <p class="m-group">{groups[s.m.group].title}</p>
          <h2>{s.m.title}{s.part && <small> ({s.part})</small>}</h2>
          {s.m.patent && <p class="m-patent">대표 보유 특허 {s.m.patent.no}</p>}
          <p class="m-short">{s.m.short}</p>
          <div class="m-qr">
            <img src={`/img/qr/${s.m.slug}.svg`} alt="">
            <p>홈페이지에서<br>자세히 보기</p>
          </div>
        </header>
        <div class="m-body">
          {s.blocks.map((b) => (
            <div class="blk">
              <h3>{b.title}</h3>
              {b.type === 'text' && <div class="txt">{b.paras.map((p) => <p>{p}</p>)}</div>}
              {b.type === 'list' && <ul class="dots">{b.items.map((t) => <li>{t}</li>)}</ul>}
              {(b.type === 'steps' || b.type === 'figures') && (
                <div class:list={['grid', b.type, { contain: b.type === 'figures' || (b.type === 'steps' && b.contain) }]} style={`--c:${b.cols ?? 3};--r:${b.ratio ?? '3 / 2'}`}>
                  {b.items.map((it, k) => (
                    <figure>
                      <div class="ph"><img src={it.img} alt=""></div>
                      <figcaption>{b.type === 'steps' && <b>{k + 1}.</b>}{it.cap}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
              {b.type === 'dl' && (
                <dl class="dl">{b.items.map((d) => <div><dt>{d.dt}</dt>{d.dd && <dd>{d.dd.join(' ')}</dd>}</div>)}</dl>
              )}
            </div>
          ))}
        </div>
      </>
    )}

    {s.kind === 'back' && (
      <div class="back-in">
        <div class="back-top">
          <img class="back-symbol" src="/assets/symbol.png" alt="">
          <p class="cover-ko">{company.name}</p>
          <p class="cover-en">{company.nameEn}</p>
        </div>
        <div class="back-band">
          <table class="contact">
            <tr><th>대표</th><td>{company.ceo}</td></tr>
            <tr><th>휴대폰</th><td>{company.phone}</td></tr>
            <tr><th>이메일</th><td>{company.email}</td></tr>
            <tr><th>주소</th><td>{company.address}</td></tr>
          </table>
          <div class="back-qr"><img src="/img/qr/home.svg" alt=""><p>홈페이지</p></div>
        </div>
      </div>
    )}

    {s.kind !== 'cover' && s.kind !== 'back' && (
      <footer class="pf"><span class="pf-name"><img src="/assets/symbol.png" alt="">{company.name}</span><b>{String(i + 1).padStart(2, '0')}</b></footer>
    )}
  </section>
))}

<script>
  // 로고 영문 줄 폭을 국문 폭에 맞춘다(CI 규칙)
  document.fonts.ready.then(() => {
    document.querySelectorAll<HTMLElement>('.cover-en').forEach((en) => {
      const ko = en.previousElementSibling as HTMLElement;
      let fs = parseFloat(getComputedStyle(en).fontSize);
      for (let i = 0; i < 6; i++) {
        fs *= ko.getBoundingClientRect().width / en.getBoundingClientRect().width;
        en.style.fontSize = fs + 'px';
      }
    });
  });
</script>
</body>
</html>

<style is:global>
  @page { size: A4; margin: 0; }
  :root { --navy: #102B4A; --steel: #35628D; --light: #759FCC; --ink: #172B40; --soft: #F5F8FB; --line: #DFE6EE; --muted: #5E6E80; }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  html, body { background: #8a96a3; }
  body { font-family: "Noto Sans KR", sans-serif; color: var(--ink); font-size: 9.6pt; line-height: 1.6; word-break: keep-all; }
  img { display: block; max-width: 100%; }
  ul, ol { list-style: none; }

  .sheet { position: relative; width: 210mm; height: 297mm; overflow: hidden; background: #fff; margin: 0 auto 8mm; page-break-after: always; break-after: page; }
  @media print { html, body { background: #fff; } .sheet { margin: 0; } }

  .pad { padding: 20mm 18mm 0; }
  .eyebrow { color: var(--steel); font-weight: 700; font-size: 9pt; letter-spacing: .18em; }
  .big { font-size: 24pt; color: var(--navy); line-height: 1.3; margin-top: 1mm; }
  .lead { color: var(--muted); font-size: 10.5pt; margin-top: 2mm; }
  .sub { font-size: 12.5pt; color: var(--navy); margin: 9mm 0 3.5mm; padding-left: 3mm; border-left: 1.2mm solid var(--steel); line-height: 1.3; }
  .dots li { position: relative; padding-left: 4mm; }
  .dots li + li { margin-top: 1mm; }
  .dots li::before { content: ""; position: absolute; left: .6mm; top: .66em; width: 1.5mm; height: 1.5mm; border-radius: 50%; background: var(--light); }

  /* 쪽 번호 */
  .pf { position: absolute; left: 18mm; right: 18mm; bottom: 9mm; display: flex; justify-content: space-between; align-items: center; font-size: 8pt; color: var(--muted); border-top: .3mm solid var(--line); padding-top: 2.5mm; }
  .pf b { color: var(--navy); font-size: 9pt; }
  .pf-name { display: flex; align-items: center; gap: 1.6mm; color: var(--navy); font-weight: 500; }
  .pf-name img { height: 4.6mm; width: auto; mix-blend-mode: multiply; }

  /* 표지 */
  .cover-in, .back-in { height: 100%; display: flex; flex-direction: column; }
  .cover-top { padding: 34mm 22mm 0; display: flex; flex-direction: column; align-items: flex-start; }
  .cover-symbol { width: 58mm; mix-blend-mode: multiply; }
  .cover-ko { font-size: 30pt; font-weight: 700; color: var(--navy); line-height: 1; margin-top: 10mm; letter-spacing: -.01em; }
  .cover-en { font-size: 9.6pt; color: var(--ink); margin-top: 2.6mm; line-height: 1; white-space: nowrap; }
  .cover-mid { padding: 26mm 22mm 0; flex: 1; }
  .cover-eyebrow { color: var(--steel); font-weight: 700; font-size: 12pt; }
  .cover-mid h1 { font-size: 27pt; line-height: 1.38; color: var(--navy); margin-top: 3mm; letter-spacing: -.01em; }
  .cover-band { background: var(--navy); color: #fff; padding: 12mm 22mm 16mm; }
  .band-tit { font-size: 9pt; letter-spacing: .12em; color: #B9CCE0; font-weight: 700; margin-bottom: 4mm; }
  .cover-band li { font-size: 12pt; font-weight: 700; padding: 2.2mm 0; border-top: .3mm solid rgba(255,255,255,.18); }
  .cover-band li span { display: inline-block; width: 46mm; font-size: 9.5pt; font-weight: 400; color: #B9CCE0; }

  /* 차례 */
  .toc-list li { display: flex; align-items: baseline; gap: 6mm; font-size: 12.5pt; font-weight: 500; padding: 3mm 0; border-bottom: .3mm solid var(--line); }
  .toc-list li b { width: 10mm; color: var(--steel); font-size: 12pt; }
  .toc-list li em { font-style: normal; font-size: 8.5pt; color: #fff; background: var(--navy); border-radius: 1mm; padding: .2mm 2mm; margin-left: 2mm; }
  .pad > .toc-list { margin-top: 12mm; }
  .toc-group { margin-top: 10mm; }
  .toc-g { font-size: 10pt; font-weight: 700; color: #fff; display: inline-block; padding: .8mm 4mm; border-radius: 1mm; margin-bottom: 1mm; }
  .toc-group.reinforce .toc-g { background: var(--steel); }
  .toc-group.pile .toc-g { background: var(--navy); }
  .toc-note { margin-top: 14mm; color: var(--muted); font-size: 10pt; line-height: 1.8; }

  /* 회사 소개 */
  .greet { margin-top: 8mm; font-size: 10.5pt; line-height: 1.85; }
  .greet p + p { margin-top: 2.5mm; }
  .greet .sign { margin-top: 5mm; color: var(--muted); }
  .greet .sign b { color: var(--navy); font-size: 13pt; margin-left: 2mm; }
  .work { display: grid; grid-template-columns: 1fr 1fr; gap: 5mm; }
  .work-box { background: var(--soft); border-radius: 3mm; padding: 5mm 6mm; border-top: 1.2mm solid var(--steel); }
  .work-box.pile { border-top-color: var(--navy); }
  .wb-t { font-size: 12pt; font-weight: 700; color: var(--navy); }
  .wb-l { font-size: 9pt; color: var(--muted); margin: 1mm 0 3mm; line-height: 1.55; }
  .info, .contact { width: 100%; border-collapse: collapse; }
  .info th, .info td { text-align: left; padding: 2.4mm 0; border-bottom: .3mm solid var(--line); vertical-align: top; }
  .info th { width: 24mm; color: var(--muted); font-weight: 500; }

  /* 특허 */
  .certs { display: flex; flex-direction: column; gap: 6mm; margin-top: 7mm; }
  .certs figure { display: grid; grid-template-columns: 50mm 1fr; gap: 8mm; align-items: center; padding-bottom: 6mm; border-bottom: .3mm solid var(--line); }
  .certs figure:last-child { border-bottom: 0; }
  .certs img { border: .3mm solid var(--line); box-shadow: 0 1mm 3mm rgba(16,43,74,.12); }
  .certs figcaption { display: flex; flex-direction: column; gap: 1.4mm; }
  .certs figcaption b { color: #fff; background: var(--navy); align-self: flex-start; font-size: 8.5pt; padding: .4mm 2.4mm; border-radius: 1mm; }
  .certs .pm { font-size: 14pt; font-weight: 700; color: var(--navy); line-height: 1.35; margin-top: 1mm; }
  .certs .pn { font-size: 9.5pt; color: var(--ink); line-height: 1.55; }
  .certs .ps { font-size: 9.5pt; color: var(--steel); font-weight: 500; }
  .certs .pd { font-size: 8.5pt; color: var(--muted); }
  .certs .pg { font-size: 8.5pt; color: var(--navy); font-weight: 700; }

  /* 공법 한눈에 보기 */
  .ov { margin-top: 9mm; }
  .ov-g { display: inline-block; color: #fff; font-weight: 700; font-size: 10pt; padding: .8mm 4mm; border-radius: 1mm; margin-bottom: 2mm; }
  .ov.reinforce .ov-g { background: var(--steel); }
  .ov.pile .ov-g { background: var(--navy); }
  .ov table { width: 100%; border-collapse: collapse; }
  .ov th { text-align: left; font-size: 8.5pt; color: var(--muted); font-weight: 500; padding: 1.6mm 2mm; border-bottom: .5mm solid var(--navy); }
  .ov td { font-size: 9.4pt; padding: 3.2mm 2mm; border-bottom: .3mm solid var(--line); vertical-align: top; }
  .ov td.ov-n { font-weight: 700; color: var(--navy); width: 56mm; }
  .ov td.ov-n em { font-style: normal; font-size: 7.5pt; color: #fff; background: var(--navy); border-radius: 1mm; padding: .1mm 1.6mm; margin-left: 1.6mm; vertical-align: 1px; }
  .ov td.ov-p { width: 10mm; text-align: right; color: var(--steel); font-weight: 700; }
  .ov th:last-child { text-align: right; }

  /* 공법 쪽 */
  .m-head { position: relative; padding: 12mm 44mm 5.5mm 18mm; color: #fff; background: var(--steel); }
  .pile .m-head { background: var(--navy); }
  .m-group { font-size: 8.5pt; letter-spacing: .1em; opacity: .8; font-weight: 500; }
  .m-head h2 { font-size: 19pt; line-height: 1.3; margin-top: .5mm; }
  .m-head h2 small { font-size: 11pt; font-weight: 400; opacity: .75; }
  .m-patent { display: inline-block; margin-top: 2mm; background: #fff; color: var(--navy); font-size: 8.5pt; font-weight: 700; border-radius: 1mm; padding: .3mm 2.4mm; }
  .m-short { margin-top: 2mm; font-size: 10pt; opacity: .92; }
  .m-body { padding: 6mm 18mm 0; }
  .blk + .blk { margin-top: 5.5mm; }
  .blk h3 { font-size: 11pt; color: var(--navy); padding-left: 2.6mm; border-left: 1mm solid var(--steel); line-height: 1.25; margin-bottom: 2.6mm; }
  .pile .blk h3 { border-left-color: var(--navy); }
  .txt p + p { margin-top: 1.5mm; }
  .grid { display: grid; grid-template-columns: repeat(var(--c), 1fr); gap: 2.6mm; }
  .grid figure { border: .3mm solid var(--line); border-radius: 1.6mm; overflow: hidden; display: flex; flex-direction: column; }
  .grid .ph { aspect-ratio: var(--r); background: var(--soft); overflow: hidden; }
  .grid .ph img { width: 100%; height: 100%; object-fit: cover; }
  .grid.contain .ph { background: #fff; padding: 1mm; }
  .grid.contain .ph img { object-fit: contain; }
  .grid figcaption { flex: 1; font-size: 8pt; font-weight: 500; line-height: 1.4; padding: 1.4mm 2mm 1.8mm; border-top: .3mm solid var(--line); }
  .grid figcaption b { color: var(--steel); margin-right: 1mm; }
  .grid.figures figcaption { text-align: center; color: var(--muted); font-weight: 400; }
  .dl > div { padding: 1.3mm 0; border-top: .3mm solid var(--line); }
  .dl > div:last-child { border-bottom: .3mm solid var(--line); }
  .dl dt { font-weight: 700; color: var(--navy); font-size: 9.4pt; }
  .dl dd { font-size: 9pt; margin-top: .4mm; }
