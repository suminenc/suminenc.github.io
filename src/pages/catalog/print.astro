---
// 카탈로그 인쇄용 페이지(A4 세로 20쪽). Edge로 PDF를 뽑는다: tools/web-images/make_catalog_pdf.ps1
import { company } from '../../data/site';
import { groups, methods, patents, type Block, type Method } from '../../data/methods';
import { catalogPages, overview, type CatBlock } from '../../data/catalog';

const bySlug = (s: string) => methods.find((m) => m.slug === s)!;

type CB = Block & { cols?: number; ratio?: string; split?: boolean; no?: number[] };
type Sheet =
  | { kind: 'cover' } | { kind: 'toc' } | { kind: 'about' } | { kind: 'patent' } | { kind: 'overview' } | { kind: 'back' }
  | { kind: 'method'; m: Method; part?: string; blocks: CB[] };

// 카탈로그용으로 블록을 고른다(칸 수·항목 고르기)
const pick = (m: Method, c: CatBlock): CB => {
  const b = m.blocks[c.block];
  if (!b) throw new Error(`${m.slug} block ${c.block} 없음`);
  const out: any = { ...b, cols: c.cols, ratio: c.ratio, split: c.split };
  if (c.title) out.title = c.title;
  if (c.take && 'items' in b) out.items = c.take.map((i) => (b.items as any[])[i]);
  if (c.take && c.keepNo) out.no = c.take;
  return out;
};

const sheets: Sheet[] = [
  { kind: 'cover' }, { kind: 'toc' }, { kind: 'about' }, { kind: 'patent' }, { kind: 'overview' },
  ...catalogPages.map((p) => {
    const m = bySlug(p.slug);
    return { kind: 'method' as const, m, part: p.part, blocks: p.blocks.map((c) => pick(m, c)) };
  }),
  { kind: 'back' },
];

// 펼침면 규칙(대표님 2026-11-01): 한 공법은 2쪽을 넘지 않고, 2쪽이면 짝수 쪽(왼쪽)에서 시작해 펼친 두 쪽에 다 보이게.
// 전체 쪽수는 책자 인쇄를 위해 4의 배수.
{
  const pages = new Map<string, number[]>();
  sheets.forEach((s, i) => { if (s.kind === 'method') pages.set(s.m.slug, [...(pages.get(s.m.slug) ?? []), i + 1]); });
  for (const [slug, ps] of pages) {
    if (ps.length > 2) throw new Error(`카탈로그: ${slug}가 ${ps.length}쪽 — 2쪽을 넘으면 안 됨`);
    if (ps.length === 2 && (ps[0] % 2 !== 0 || ps[1] !== ps[0] + 1)) throw new Error(`카탈로그: ${slug}가 ${ps.join('·')}쪽 — 짝수 쪽에서 시작하는 펼침면이어야 함`);
  }
  if (sheets.length % 4 !== 0) throw new Error(`카탈로그: 전체 ${sheets.length}쪽 — 4의 배수여야 함`);
}

// 목차: 공법마다 첫 쪽 번호
const toc: { m: Method; page: number }[] = [];
sheets.forEach((s, i) => {
  if (s.kind === 'method' && !toc.some((t) => t.m.slug === s.m.slug)) toc.push({ m: s.m, page: i + 1 });
});
const groupKeys = ['reinforce', 'pile'] as const;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="robots" content="noindex">
  <title>{company.name} 카탈로그</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
{sheets.map((s, i) => (
  <section class:list={['sheet', s.kind, s.kind === 'method' && s.m.group]}>
    {s.kind === 'cover' && (
      <div class="cover-in">
        <div class="cover-top">
          <div class="lockup-v cover-lockup">
            <img class="lv-sym" src="/assets/symbol-crop.png" alt="">
            <p class="cover-ko">{company.name}</p>
            <p class="cover-en">{company.nameEn}</p>
          </div>
        </div>
        <div class="cover-mid">
          <p class="cover-eyebrow">구조보강 · 소구경파일</p>
          <h1>건물을 허물지 않고<br>더 튼튼하게 보강합니다.</h1>
        </div>
        <div class="cover-band">
          <p class="band-tit">대표 보유 특허</p>
          <ul>{patents.map((m) => <li><span>특허 {m.patent!.no}</span>{m.title}</li>)}</ul>
        </div>
      </div>
    )}

    {s.kind === 'toc' && (
      <div class="pad">
        <p class="eyebrow">CONTENTS</p>
        <h2 class="big">차례</h2>
        <ol class="toc-list">
          <li><b>03</b>회사 소개</li>
          <li><b>04</b>대표 보유 특허</li>
          <li><b>05</b>공법 한눈에 보기</li>
        </ol>
        {groupKeys.map((g) => (
          <>
            <i class="sp"></i>
            <div class:list={['toc-group', g]}>
              <p class="toc-g">{groups[g].title}</p>
              <ol class="toc-list">
                {toc.filter((t) => t.m.group === g).map((t) => (
                  <li><b>{String(t.page).padStart(2, '0')}</b>{t.m.title}{t.m.patent && <em>특허</em>}</li>
                ))}
              </ol>
            </div>
          </>
        ))}
        <i class="sp"></i>
        <p class="toc-note">{company.name}는 건축물 구조보강과 소구경파일 기초보강 공사를 합니다.<br>공법마다 실린 QR을 찍으면 홈페이지에서 영상과 자세한 내용을 볼 수 있습니다.</p>
      </div>
    )}

    {s.kind === 'about' && (
      <div class="pad">
        <p class="eyebrow">ABOUT</p>
        <h2 class="big">회사 소개</h2>
        <div class="greet">
          <p>{company.name}는 건축물 구조보강과 소구경파일 기초보강 공사를 하는 회사입니다.</p>
          <p>오래된 건물, 하중이 늘어난 건물, 좁아서 큰 장비가 들어가지 못하는 현장일수록 정확한 공법 선택이 중요합니다. 현장 여건을 먼저 살피고, 알맞은 공법을 제안해 꼼꼼하게 시공하겠습니다.</p>
          <p>보유한 특허 공법 3건(SMART섬유보강, 마이크로파일 상부정착 HNC, 마찰저항증대 FIP)으로 더 경제적이고 튼튼한 보강을 약속드립니다.</p>
          <p class="sign">{company.name} 대표 <b>{company.ceo}</b></p>
        </div>
        <i class="sp"></i>
        <h3 class="sub">하는 일</h3>
        <div class="work">
          {groupKeys.map((g) => (
            <div class:list={['work-box', g]}>
              <p class="wb-t">{groups[g].title}</p>
              <p class="wb-l">{groups[g].lead}</p>
              <ul class="dots">{methods.filter((m) => m.group === g).map((m) => <li>{m.title}</li>)}</ul>
            </div>
          ))}
        </div>
        <i class="sp"></i>
        <h3 class="sub">사업장 정보</h3>
        <table class="info">
          <tr><th>상호</th><td>{company.name} ({company.nameEn})</td></tr>
          <tr><th>대표</th><td>{company.ceo}</td></tr>
          <tr><th>주소</th><td>{company.address}</td></tr>
          <tr><th>휴대폰</th><td>{company.phone}</td></tr>
          <tr><th>이메일</th><td>{company.email}</td></tr>
        </table>
      </div>
    )}

    {s.kind === 'patent' && (
      <div class="pad">
        <p class="eyebrow">PATENT</p>
        <h2 class="big">대표 보유 특허 3건</h2>
        <p class="lead">특허권자 {company.ceo} · 특허청 등록</p>
        <div class="certs">
          {patents.map((m) => (
            <figure>
              <img src={m.patent!.cert} alt={`특허증 ${m.patent!.no}`}>
              <figcaption>
                <b>특허 {m.patent!.no}</b>
                <span class="pm">{m.title}</span>
                <span class="pn">{m.patent!.name}</span>
                <span class="ps"><em>적용</em>{overview[m.slug].fit}</span>
                <span class="ps"><em>특징</em>{overview[m.slug].point}</span>
                <span class="pd">등록일 {m.patent!.registered} · 특허권자 {company.ceo}</span>
                <span class="pg">자세한 내용 {String(toc.find((t) => t.m.slug === m.slug)!.page).padStart(2, '0')}쪽</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    )}

    {s.kind === 'overview' && (
      <div class="pad">
        <p class="eyebrow">OVERVIEW</p>
        <h2 class="big">공법 한눈에 보기</h2>
        <p class="lead">현장 여건에 맞는 공법을 골라 제안합니다.</p>
        {groupKeys.map((g) => (
          <div class:list={['ov', g]}>
            <p class="ov-g">{groups[g].title}</p>
            <table>
              <tr><th>공법</th><th>이런 현장에</th><th>특징</th><th>쪽</th></tr>
              {toc.filter((t) => t.m.group === g).map((t) => (
                <tr>
                  <td class="ov-n">{t.m.title}{t.m.patent && <em>특허</em>}</td>
                  <td>{overview[t.m.slug].fit}</td>
                  <td>{overview[t.m.slug].point}</td>
                  <td class="ov-p">{String(t.page).padStart(2, '0')}</td>
                </tr>
              ))}
            </table>
          </div>
        ))}
      </div>
    )}

    {s.kind === 'method' && (
      <>
        <header class="m-head">
          <p class="m-group">{groups[s.m.group].title}</p>
          <h2>{s.m.title}{s.part && <small> ({s.part})</small>}</h2>
          {s.m.patent && <p class="m-patent">대표 보유 특허 {s.m.patent.no}</p>}
          <p class="m-short">{s.m.short}</p>
          <div class="m-qr">
            <img src={`/img/qr/${s.m.slug}.svg`} alt="">
            <p>홈페이지에서<br>자세히 보기</p>
          </div>
        </header>
        <div class="m-body">
          {s.blocks.map((b) => (
            <div class="blk">
              <h3>{b.title}</h3>
              {b.type === 'text' && <div class="txt">{b.paras.map((p) => <p>{p}</p>)}</div>}
              {b.type === 'list' && <ul class="dots">{b.items.map((t) => <li>{t}</li>)}</ul>}
              {(b.type === 'steps' || b.type === 'figures') && (
                <div class:list={['grid', b.type, { contain: b.type === 'figures' || (b.type === 'steps' && b.contain) }]} style={`--c:${b.cols ?? 3};--r:${b.ratio ?? '3 / 2'}`}>
                  {b.items.map((it, k) => (
                    <figure>
                      <div class="ph"><img src={it.img} alt=""></div>
                      <figcaption>{b.type === 'steps' && <b>{(b.no ? b.no[k] : k) + 1}.</b>}{it.cap}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
              {b.type === 'dl' && (
                <dl class:list={['dl', { two: b.split }]}>{b.items.map((d) => <div><dt>{d.dt}</dt>{d.dd && <dd>{d.dd.join(' ')}</dd>}</div>)}</dl>
              )}
            </div>
          ))}
        </div>
      </>
    )}

    {s.kind === 'back' && (
      <div class="back-in">
        <div class="back-top">
          <div class="lockup-v back-lockup">
            <img class="lv-sym" src="/assets/symbol-crop.png" alt="">
            <p class="cover-ko">{company.name}</p>
            <p class="cover-en">{company.nameEn}</p>
          </div>
        </div>
        <div class="back-band">
          <table class="contact">
            <tr><th>대표</th><td>{company.ceo}</td></tr>
            <tr><th>휴대폰</th><td>{company.phone}</td></tr>
            <tr><th>이메일</th><td>{company.email}</td></tr>
            <tr><th>주소</th><td>{company.address}</td></tr>
          </table>
          <div class="back-qr"><img src="/img/qr/home.svg" alt=""><p>홈페이지</p></div>
        </div>
      </div>
    )}

    {s.kind !== 'cover' && s.kind !== 'back' && (
      <footer class="pf"><span class="pf-name"><img src="/assets/symbol.png" alt="">{company.name}</span><b>{String(i + 1).padStart(2, '0')}</b></footer>
    )}
  </section>
))}

<script>
  // 세로형 로고(CI v2.3 6쪽): 영문 폭 = 국문 폭, 심볼 폭 = 국문 폭 × 0.80, 심볼과 국문 사이 = 심볼 높이 × 0.16
  // 심볼은 원본에서 보이는 부분만 자른 그림(1241×1160)
  function lockups() {
    document.querySelectorAll<HTMLElement>('.lockup-v').forEach((lv) => {
      const sym = lv.querySelector<HTMLImageElement>('.lv-sym')!;
      const ko = lv.querySelector<HTMLElement>('.cover-ko')!;
      const en = lv.querySelector<HTMLElement>('.cover-en')!;
      let fs = parseFloat(getComputedStyle(en).fontSize);
      for (let i = 0; i < 8; i++) {
        fs *= ko.getBoundingClientRect().width / en.getBoundingClientRect().width;
        en.style.fontSize = fs + 'px';
      }
      const kw = ko.getBoundingClientRect().width;
      const sw = kw * 0.8, sh = (sw * 1160) / 1241;
      sym.style.width = sw + 'px';
      sym.style.height = sh + 'px';
      sym.style.marginBottom = sh * 0.16 + 'px';
      en.style.marginTop = parseFloat(getComputedStyle(ko).fontSize) * 0.22 + 'px';
    });
  }

  // 공법 쪽 아래 여백 줄이기: 남는 높이를 사진 줄마다 나눠 사진 칸을 키운다.
  // 현장 사진(잘라 채움)은 세로가 가로의 1.1배까지, 도면(전체 보임)은 높이 25%까지만 키운다. 그래도 남으면 블록 사이(flex)에 나뉜다.
  function fillMethods() {
    document.querySelectorAll<HTMLElement>('.sheet.method .m-body').forEach((body) => {
      const used = [...body.children].reduce((s, c) => s + (c as HTMLElement).offsetHeight, 0);
      const gaps = parseFloat(getComputedStyle(body).rowGap) * (body.children.length - 1);
      let free = body.clientHeight - parseFloat(getComputedStyle(body).paddingTop) - used - gaps - 2;
      if (free <= 0) return;
      const rows: { phs: HTMLElement[]; max: number }[] = [];
      body.querySelectorAll<HTMLElement>('.grid').forEach((g) => {
        const cols = parseInt(getComputedStyle(g).getPropertyValue('--c')) || 3;
        const phs = [...g.querySelectorAll<HTMLElement>('.ph')];
        const w = phs[0].getBoundingClientRect().width, h = phs[0].getBoundingClientRect().height;
        const max = g.classList.contains('contain') ? h * 0.25 : Math.max(0, w * 1.1 - h);
        for (let i = 0; i < phs.length; i += cols) rows.push({ phs: phs.slice(i, i + cols), max });
      });
      // 줄마다 같은 만큼(상한 안에서) 키운다
      let left = free, open = rows.filter((r) => r.max > 0);
      const add = new Map<object, number>();
      while (left > 1 && open.length) {
        const each = left / open.length;
        open.forEach((r) => {
          const cur = add.get(r) || 0, d = Math.min(each, r.max - cur);
          add.set(r, cur + d); left -= d;
        });
        open = open.filter((r) => (add.get(r) || 0) < r.max - .5);
      }
      rows.forEach((r) => {
        const d = add.get(r) || 0;
        if (d > 0) r.phs.forEach((ph) => {
          const h = ph.getBoundingClientRect().height;
          ph.style.aspectRatio = 'auto';
          ph.style.height = h + d + 'px';
        });
      });
    });
  }

  document.fonts.ready.then(() => {
    lockups();
    fillMethods();
    document.body.dataset.ready = '1';
  });
</script>
</body>
</html>

<style is:global>
  @page { size: A4; margin: 0; }
  :root { --navy: #102B4A; --steel: #35628D; --light: #759FCC; --ink: #172B40; --soft: #F5F8FB; --line: #DFE6EE; --muted: #5E6E80; }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  html, body { background: #8a96a3; }
  body { font-family: "Noto Sans KR", sans-serif; color: var(--ink); font-size: 9.6pt; line-height: 1.6; word-break: keep-all; }
  img { display: block; max-width: 100%; }
  ul, ol { list-style: none; }

  .sheet { position: relative; width: 210mm; height: 297mm; overflow: hidden; background: #fff; margin: 0 auto 8mm; page-break-after: always; break-after: page; }
  @media print { html, body { background: #fff; } .sheet { margin: 0; } }

  .pad { padding: 20mm 18mm 0; }
  /* 쪽 아래 여백 관리: 본문은 쪽 아래 선 6mm 위(274mm)까지 채운다. 남는 높이는 .sp 늘이개가 나눠 가진다 */
  .toc .pad, .about .pad, .patent .pad, .overview .pad { height: 274mm; display: flex; flex-direction: column; }
  .sp { display: block; flex: 1 1 0; min-height: 0; }
  .eyebrow { color: var(--steel); font-weight: 700; font-size: 9pt; letter-spacing: .18em; }
  .big { font-size: 24pt; color: var(--navy); line-height: 1.3; margin-top: 1mm; }
  .lead { color: var(--muted); font-size: 10.5pt; margin-top: 2mm; }
  .sub { font-size: 12.5pt; color: var(--navy); margin: 9mm 0 3.5mm; padding-left: 3mm; border-left: 1.2mm solid var(--steel); line-height: 1.3; }
  .dots li { position: relative; padding-left: 4mm; }
  .dots li + li { margin-top: 1mm; }
  .dots li::before { content: ""; position: absolute; left: .6mm; top: .66em; width: 1.5mm; height: 1.5mm; border-radius: 50%; background: var(--light); }

  /* 쪽 번호 */
  .pf { position: absolute; left: 18mm; right: 18mm; bottom: 9mm; display: flex; justify-content: space-between; align-items: center; font-size: 8pt; color: var(--muted); border-top: .3mm solid var(--line); padding-top: 2.5mm; }
  .pf b { color: var(--navy); font-size: 9pt; }
  .pf-name { display: flex; align-items: center; gap: 1.6mm; color: var(--navy); font-weight: 500; }
  .pf-name img { height: 4.6mm; width: auto; mix-blend-mode: multiply; }

  /* 표지 */
  .cover-in, .back-in { height: 100%; display: flex; flex-direction: column; }
  .cover-top { padding: 34mm 22mm 0; display: flex; flex-direction: column; align-items: flex-start; }
  .lockup-v { display: inline-flex; flex-direction: column; align-items: center; }
  .lv-sym { display: block; mix-blend-mode: multiply; }
  .cover-ko { font-weight: 700; color: var(--navy); line-height: 1; letter-spacing: -.01em; white-space: nowrap; }
  .cover-en { font-size: 9.6pt; color: var(--ink); line-height: 1; white-space: nowrap; }
  .cover-lockup .cover-ko { font-size: 40pt; }
  .back-lockup .cover-ko { font-size: 26pt; }
  .cover-mid { padding: 26mm 22mm 0; flex: 1; }
  .cover-eyebrow { color: var(--steel); font-weight: 700; font-size: 12pt; }
  .cover-mid h1 { font-size: 27pt; line-height: 1.38; color: var(--navy); margin-top: 3mm; letter-spacing: -.01em; }
  .cover-band { background: var(--navy); color: #fff; padding: 12mm 22mm 16mm; }
  .band-tit { font-size: 9pt; letter-spacing: .12em; color: #B9CCE0; font-weight: 700; margin-bottom: 4mm; }
  .cover-band li { font-size: 12pt; font-weight: 700; padding: 2.2mm 0; border-top: .3mm solid rgba(255,255,255,.18); }
  .cover-band li span { display: inline-block; width: 46mm; font-size: 9.5pt; font-weight: 400; color: #B9CCE0; }

  /* 차례 */
  .toc-list li { display: flex; align-items: baseline; gap: 6mm; font-size: 12.5pt; font-weight: 500; padding: 2.9mm 0; border-bottom: .3mm solid var(--line); }
  .toc-list li b { width: 10mm; color: var(--steel); font-size: 12pt; }
  .toc-list li em { font-style: normal; font-size: 8.5pt; color: #fff; background: var(--navy); border-radius: 1mm; padding: .2mm 2mm; margin-left: 2mm; }
  .pad > .toc-list { margin-top: 12mm; }
  .toc-group { margin-top: 10mm; }
  .toc-g { font-size: 10pt; font-weight: 700; color: #fff; display: inline-block; padding: .8mm 4mm; border-radius: 1mm; margin-bottom: 1mm; }
  .toc-group.reinforce .toc-g { background: var(--steel); }
