---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, catalog } from '../data/site';
import { byGroup, groups, patents } from '../data/methods';
import MethodCards from '../components/MethodCards.astro';
import { works } from '../data/works';

const areas = (['reinforce', 'pile'] as const).map((g) => ({ key: g, ...groups[g], items: byGroup(g) }));
// 첫 화면 실적 숫자 — works.ts(시공 경력)에서 자동으로 센다(2026-11-05 대표님)
const years = works.map((w) => Number(w.ym.slice(0, 4)));
const first = Math.min(...years);
const stats = [
  { n: `${Math.max(...years) - first}년`, t: `${first}년부터 시공`, href: '/works/' },
  { n: `${works.length}곳`, t: '시공 현장', href: '/works/' },
  { n: `${works.filter((w) => w.pub).length}곳`, t: '학교·관공서 공사', href: '/works/' },
  { n: `${patents.length}건`, t: '보유 특허 공법', href: '/patent/' },
];
---
<BaseLayout>
  <section class="hero">
    <div class="inner hero-inner">
      <div>
        <p class="eyebrow">구조보강 · 소구경파일</p>
        <h1>공간은 그대로,<br>구조는 더 강하게.</h1>
        <p class="hero-lead">철판·H형강·탄소섬유 구조보강과 마이크로파일·압입파일 기초보강 공사를 합니다.</p>
        <ul class="hero-stats">
          {stats.map((x) => (
            <li><a href={x.href}><b>{x.n}</b><span>{x.t}</span></a></li>
          ))}
        </ul>
        <div class="btns">
          <a class="btn" href={`tel:${company.phone}`}>전화 걸기 {company.phone}</a>
          <a class="btn line" href="/contact/">문의 방법</a>
          <a class="btn line" href={catalog.href} download={catalog.file}>카탈로그 받기 (PDF)</a>
        </div>
      </div>
      <img class="hero-symbol" src="/assets/symbol.png" alt="" width="1315" height="1196">
    </div>
  </section>

  <div class="inner">
    {areas.map((a) => (
      <section class="section">
        <h2>{a.title} <small>{a.items.length}개 공법</small></h2>
        <p class="area-lead">{a.lead}</p>
        <MethodCards items={a.items} compact cols={a.items.length} />
      </section>
    ))}

    <section class="section">
      <h2>보유 특허</h2>
      <ul class="patent-strip">
        {patents.map((m) => (
          <li>
            <a href="/patent/">
              <span class="no">특허 {m.patent!.no}</span>
              <b>{m.title}</b>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  /* 심볼 원본 PNG가 흰 바탕이라 첫 화면 바탕도 흰색 */
  .hero { background: #fff; border-bottom: 1px solid var(--line); }
  .hero-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding-top: 64px; padding-bottom: 64px; }
  .eyebrow { color: var(--steel); font-weight: 700; font-size: 15px; }
  .hero h1 { font-size: 38px; line-height: 1.35; color: var(--navy); margin-top: 10px; letter-spacing: -.01em; }
  .hero-lead { margin: 18px 0 20px; font-size: 17px; color: var(--muted); max-width: 560px; }
  .hero-stats { display: grid; grid-template-columns: repeat(4, auto); justify-content: start; gap: 0; margin: 0 0 26px; padding: 0; list-style: none; }
  .hero-stats li + li { border-left: 1px solid var(--line); }
  .hero-stats a { display: block; padding: 2px 22px; text-decoration: none; }
  .hero-stats li:first-child a { padding-left: 0; }
  .hero-stats b { display: block; font-size: 28px; line-height: 1.2; color: var(--navy); letter-spacing: -.01em; }
  .hero-stats span { display: block; margin-top: 2px; font-size: 13.5px; color: var(--muted); }
  .hero-stats a:hover b { color: var(--steel); }
  .hero-symbol { width: 240px; flex: none; mix-blend-mode: multiply; }
  .area-lead { color: var(--muted); margin: -6px 0 16px; }
  .patent-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); }
  .patent-strip a { display: block; height: 100%; background: var(--navy); color: #fff; border-radius: 10px; padding: 16px 18px; text-decoration: none; }
  .patent-strip .no { font-size: 13px; color: #B9CCE0; }
  .patent-strip b { display: block; margin-top: 4px; font-size: 16px; line-height: 1.45; }
  @media (max-width: 860px) {
    .hero-symbol { width: 150px; }
    .patent-strip { grid-template-columns: 1fr; }
    .hero h1 { font-size: 30px; }
    }
  @media (max-width: 520px) {
    .hero-inner { flex-direction: column-reverse; align-items: flex-start; padding-top: 32px; padding-bottom: 40px; gap: 14px; }
    .hero-symbol { width: 96px; }
    .hero h1 { font-size: 26px; }
    .hero-lead { font-size: 15.5px; }
    .hero-stats { grid-template-columns: 1fr 1fr; row-gap: 14px; width: 100%; }
    .hero-stats li + li { border-left: 0; }
    .hero-stats a, .hero-stats li:first-child a { padding: 0; }
    .hero-stats b { font-size: 24px; }
    }
</style>
