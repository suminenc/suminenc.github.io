---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, catalog } from '../data/site';
import { byGroup, groups, patents } from '../data/methods';
import MethodCards from '../components/MethodCards.astro';
import { works } from '../data/works';
import CountUp from '../components/CountUp.astro';

const areas = (['reinforce', 'pile'] as const).map((g) => ({ key: g, ...groups[g], items: byGroup(g) }));
// 첫 화면 실적 숫자 — works.ts(시공 경력)에서 자동으로 센다(2026-11-05 대표님).
// 한길특수건설 시절 현장이므로 「참여」로 쓰고 아래에 출처를 밝힌다(같은 날 대표님).
// 현장 경력은 만 나이처럼 센다 — 한길 입사 2010-04-07부터 빌드한 날까지(만 16년, 햇수로는 17년. 대표님 11/05)
const START = new Date('2010-04-07');
const now = new Date();
const fullYears = now.getFullYear() - START.getFullYear() - (now < new Date(now.getFullYear(), START.getMonth(), START.getDate()) ? 1 : 0);
// 함께한 곳 — 시공 경력(works.ts)의 발주자·원청사 가운데 이름이 알려진 곳만 고름(2026-11-14 대표님).
// 로고는 쓰지 않고 글자로만. works.ts에 없는 이름은 빌드 때 저절로 빠진다.
const named = new Set(works.flatMap((w) => [w.owner, w.builder]).filter(Boolean) as string[]);
const pick = (xs: string[]) => xs.filter((x) => named.has(x));
const clients = {
  owners: pick(['한국전력', 'LH', '한국은행', '한국석유공사', '방위사업청', '국립극장', '고려대학교', '삼성전자', 'SK에너지', 'S-OIL', 'LG화학', 'CJ제일제당', '셀트리온', '한화토탈', 'LS전선', 'KCC', '신라호텔', '강원랜드']),
  builders: pick(['삼성물산', '현대건설', 'SK건설', 'GS건설', '대우건설', '롯데건설', '현대엔지니어링', '삼성엔지니어링', '코오롱글로벌', '한라건설', '신세계건설']),
};
const clientRest = named.size - clients.owners.length - clients.builders.length;
const stats = [
  { n: fullYears, u: '년', t: '현장 경력', href: '/about/' },
  { n: works.length, u: '곳', t: '참여 현장', href: '/works/' },
  { n: works.filter((w) => w.pub).length, u: '곳', t: '학교·관공서 공사', href: '/works/?m=pub' },
  { n: patents.length, u: '건', t: '보유 특허 공법', href: '/patent/' },
];
---
<BaseLayout>
  <section class="hero">
    <div class="inner hero-inner">
      <div>
        <p class="eyebrow">구조보강 · 소구경파일</p>
        <h1>공간은 그대로,<br>구조는 더 강하게.</h1>
        <p class="hero-lead">철판·H형강·탄소섬유 구조보강과 마이크로파일·압입파일 기초보강 공사를 합니다.</p>
        <div class="hero-proof">
          <ul class="hero-stats">
            {stats.map((x) => (
              <li><a href={x.href}><b><span data-count>{x.n}</span>{x.u}</b><span class="lbl">{x.t}</span></a></li>
            ))}
          </ul>
          <p class="hero-note">※ 한길특수건설(주) 재직 시 참여한 현장 포함</p>
        </div>
        <div class="btns hero-btns">
          <a class="btn call" href={`tel:${company.phone}`}>전화 걸기 {company.phone}</a>
          <a class="btn line" href={company.blog} target="_blank" rel="noopener">네이버 블로그</a>
          <a class="btn line" href="/contact/">문의 방법</a>
          <a class="btn line wide" href={catalog.href} download={catalog.file}>카탈로그 받기 (PDF)</a>
        </div>
      </div>
      <img class="hero-symbol" src="/assets/symbol.png" alt="" width="1315" height="1196">
    </div>
  </section>

  <section class="clients" aria-labelledby="clients-h">
    <div class="inner">
      <h2 id="clients-h">함께한 곳</h2>
      <dl>
        <div><dt>발주처</dt><dd><ul>{clients.owners.map((x) => <li>{x}</li>)}</ul></dd></div>
        <div><dt>원청사</dt><dd><ul>{clients.builders.map((x) => <li>{x}</li>)}</ul></dd></div>
      </dl>
      <p class="clients-more"><a href="/works/">외 {clientRest}곳, 시공 경력 전체 보기 ›</a><span>※ 한길특수건설(주) 재직 시 참여한 현장 포함</span></p>
    </div>
  </section>

  <div class="inner">
    {areas.map((a) => (
      <section class="section">
        <h2>{a.title} <small>{a.items.length}개 공법</small></h2>
        <p class="area-lead">{a.lead}</p>
        <MethodCards items={a.items} compact cols={a.items.length} />
      </section>
    ))}

    <section class="section">
      <h2>보유 특허</h2>
      <ul class="patent-strip">
        {patents.map((m) => (
          <li>
            <a href={`/patent/#${m.slug}`}>
              <span class="no">특허 {m.patent!.no}</span>
              <b>{m.title}</b>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <CountUp />
</BaseLayout>

<style>
  /* 심볼 원본 PNG가 흰 바탕이라 첫 화면 바탕도 흰색 */
  .hero { background: #fff; border-bottom: 1px solid var(--line); }
  .hero-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding-top: 64px; padding-bottom: 64px; }
  .eyebrow { color: var(--steel); font-weight: 700; font-size: 15px; }
  .hero h1 { font-size: 38px; line-height: 1.35; color: var(--navy); margin-top: 10px; letter-spacing: -.01em; }
  .hero-lead { margin: 18px 0 22px; font-size: 17px; color: var(--muted); max-width: 560px; }
  /* 실적 숫자 상자 — 숫자 4칸 + 출처 한 줄, 버튼과는 띄운다 */
  .hero-proof { max-width: 560px; margin: 0 0 28px; padding: 16px 0 12px; background: var(--soft); border: 1px solid var(--line); border-radius: 10px; }
  .hero-stats { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; padding: 0; list-style: none; }
  .hero-stats li + li { border-left: 1px solid var(--line); }
  .hero-stats a { display: block; padding: 0 8px; text-align: center; text-decoration: none; }
  .hero-stats b { display: block; font-size: 26px; line-height: 1.2; color: var(--navy); letter-spacing: -.01em; }
  .hero-stats .lbl { display: block; margin-top: 3px; font-size: 13px; color: var(--muted); }
  .hero-stats a:hover b { color: var(--steel); }
  .hero-note { margin: 12px 16px 0; padding-top: 10px; border-top: 1px dashed var(--line); font-size: 12.5px; color: var(--muted); text-align: right; }
  .hero-symbol { width: 240px; flex: none; mix-blend-mode: multiply; }
  /* 첫 화면 버튼 — 실적 상자와 같은 폭의 격자(11/09 대표님 「버튼 사이즈 정리」, 「PC는 언밸런스」).
     폰: 전화(1줄 전체) / 블로그·문의 방법(반씩) / 카탈로그(1줄 전체)
     PC: 전화(1줄 전체) / 블로그·문의 방법·카탈로그(3등분) */
  .btns.hero-btns { display: grid; grid-template-columns: 1fr 1fr; max-width: 560px; }
  .hero-btns .btn { padding: 0 10px; }
  .hero-btns .call, .hero-btns .wide { grid-column: 1 / -1; }
  @media (min-width: 760px) {
    .btns.hero-btns { grid-template-columns: repeat(3, 1fr); }
    .hero-btns .wide { grid-column: auto; }
    }
  /* 함께한 곳 띠 */
  .clients { background: var(--soft); border-bottom: 1px solid var(--line); padding: 30px 0 26px; }
  .clients h2 { font-size: 20px; color: var(--navy); margin-bottom: 14px; }
  .clients dl { display: grid; gap: 12px; margin: 0; }
  .clients dl > div { display: grid; grid-template-columns: 64px 1fr; align-items: start; gap: 12px; }
  .clients dt { font-size: 14px; font-weight: 700; color: var(--steel); padding-top: 6px; }
  .clients dd { margin: 0; }
  .clients ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .clients li { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 5px 12px; font-size: 15px; font-weight: 500; color: var(--ink); line-height: 1.5; }
  .clients-more { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; margin-top: 14px; font-size: 14px; }
  .clients-more a { color: var(--steel); font-weight: 500; text-decoration: none; }
  .clients-more span { color: var(--muted); font-size: 12.5px; }
  .area-lead { color: var(--muted); margin: -6px 0 16px; }
  .patent-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); }
  .patent-strip a { display: block; height: 100%; background: var(--navy); color: #fff; border-radius: 10px; padding: 16px 18px; text-decoration: none; }
  .patent-strip .no { font-size: 13px; color: #B9CCE0; }
  .patent-strip b { display: block; margin-top: 4px; font-size: 16px; line-height: 1.45; }
  @media (max-width: 860px) {
    .hero-symbol { width: 150px; }
    .patent-strip { grid-template-columns: 1fr; }
    .hero h1 { font-size: 30px; }
    }
  @media (max-width: 520px) {
    .clients dl > div { grid-template-columns: 1fr; gap: 6px; }
    .clients dt { padding-top: 0; }
    .clients li { font-size: 14px; padding: 4px 10px; }
    .hero-inner { flex-direction: column-reverse; align-items: flex-start; padding-top: 32px; padding-bottom: 40px; gap: 14px; }
    .hero-symbol { width: 96px; }
    .hero h1 { font-size: 26px; }
    .hero-lead { font-size: 15.5px; }
    .hero-proof { width: 100%; padding-top: 14px; }
    .hero-stats { grid-template-columns: 1fr 1fr; row-gap: 14px; }
    .hero-stats li:nth-child(odd) { border-left: 0; }
    .hero-stats b { font-size: 23px; }
    .hero-note { text-align: center; }
    }
</style>
