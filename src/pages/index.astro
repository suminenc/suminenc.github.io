---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/site';
import { byGroup, groups, patents } from '../data/methods';

const areas = (['reinforce', 'pile'] as const).map((g) => ({ key: g, ...groups[g], items: byGroup(g) }));
---
<BaseLayout>
  <section class="hero">
    <div class="inner hero-inner">
      <div>
        <p class="eyebrow">구조보강 · 소구경파일</p>
        <h1>건물을 허물지 않고<br>더 튼튼하게 보강합니다.</h1>
        <p class="hero-lead">철판·형강·탄소섬유 구조보강과 마이크로파일·압입파일 기초보강 공사를 합니다. 대표 보유 특허 공법 3건으로 시공합니다.</p>
        <div class="btns">
          <a class="btn" href={`tel:${company.phone}`}>전화 걸기 {company.phone}</a>
          <a class="btn line" href="/contact/">문의 방법</a>
        </div>
      </div>
      <img class="hero-symbol" src="/assets/symbol.png" alt="" width="1315" height="1196">
    </div>
  </section>

  <div class="inner">
    {areas.map((a) => (
      <section class="section">
        <h2>{a.title} <small>{a.items.length}개 공법</small></h2>
        <p class="area-lead">{a.lead}</p>
        <ul class="area-list">
          {a.items.map((m) => (
            <li>
              <a href={`/method/${m.group}/${m.slug}/`}>
                <img src={m.thumb} alt="" loading="lazy" decoding="async">
                <span>
                  <b>{m.title}</b>
                  {m.patent && <em>특허 {m.patent.no}</em>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="section">
      <h2>대표 보유 특허</h2>
      <ul class="patent-strip">
        {patents.map((m) => (
          <li>
            <a href="/patent/">
              <span class="no">특허 {m.patent!.no}</span>
              <b>{m.title}</b>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  /* 심볼 원본 PNG가 흰 바탕이라 첫 화면 바탕도 흰색 */
  .hero { background: #fff; border-bottom: 1px solid var(--line); }
  .hero-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding-top: 64px; padding-bottom: 64px; }
  .eyebrow { color: var(--steel); font-weight: 700; font-size: 15px; }
  .hero h1 { font-size: 38px; line-height: 1.35; color: var(--navy); margin-top: 10px; letter-spacing: -.01em; }
  .hero-lead { margin: 18px 0 26px; font-size: 17px; color: var(--muted); max-width: 560px; }
  .hero-symbol { width: 240px; flex: none; }
  .area-lead { color: var(--muted); margin: -6px 0 16px; }
  .area-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .area-list a { display: flex; align-items: center; gap: 12px; border: 1px solid var(--line); border-radius: 10px; padding: 10px; text-decoration: none; color: var(--ink); height: 100%; }
  .area-list a:hover { background: var(--soft); }
  .area-list img { width: 72px; height: 54px; object-fit: cover; border-radius: 6px; flex: none; background: var(--soft); }
  .area-list b { display: block; font-size: 15.5px; color: var(--navy); line-height: 1.4; }
  .area-list em { display: block; font-style: normal; font-size: 12.5px; color: var(--steel); margin-top: 2px; }
  .patent-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .patent-strip a { display: block; height: 100%; background: var(--navy); color: #fff; border-radius: 10px; padding: 16px 18px; text-decoration: none; }
  .patent-strip .no { font-size: 13px; color: #B9CCE0; }
  .patent-strip b { display: block; margin-top: 4px; font-size: 16px; line-height: 1.45; }
  @media (max-width: 860px) {
    .hero-symbol { width: 150px; }
    .hero h1 { font-size: 30px; }
    .area-list, .patent-strip { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .hero-inner { flex-direction: column-reverse; align-items: flex-start; padding-top: 32px; padding-bottom: 40px; gap: 14px; }
    .hero-symbol { width: 96px; }
    .hero h1 { font-size: 26px; }
    .hero-lead { font-size: 15.5px; }
    .area-list, .patent-strip { grid-template-columns: 1fr; }
  }
</style>
